---
import resume from "../../resume.json";

const { socials } = resume;
---

<footer class="border-t border-border py-4 flex w-full gap-6">
  {
    socials.map((item) => (
      <a href={item.href} class="text-foreground-muted hover:text-foreground">
        {item.label}
      </a>
    ))
  }
  <p class="ml-auto text-foreground-muted">@ 2026 Keez Eden</p>
</footer>
