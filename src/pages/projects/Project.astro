---
const { title, subtitle, description, tools = [], link } = Astro.props;
---

<div>
  <div class="flex">
    <p class="font-semibold">{title}</p>
    <a href={link} target="_blank" class="font-semibold ml-auto text-foreground-muted">{subtitle} &#8599;</a>
  </div>
  <div class="flex flex-col pb-2">
    <p class="w-full">{description}</p>
    <p class="font-semibold text-foreground-muted">{tools.join(", ")}</p>
  </div>
</div>
