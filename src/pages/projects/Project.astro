---
const { title, subtitle, description, tools } = Astro.props;
---

<div class="mt-6">
  <div class="flex">
    <p class="font-semibold">{title}</p>
    <p class="font-semibold ml-auto text-foreground-muted">{subtitle}</p>
  </div>
  <div class="flex pb-2">
    <p class="">{description}</p>
    <p class="font-semibold ml-auto text-foreground-muted">{tools}</p>
  </div>
</div>
