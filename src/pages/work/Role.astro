---
const { company, location, title, period, tasks = [] } = Astro.props;
---

<div class="mt-6">
  <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
    <p class="font-semibold">{company}</p>
    <p class="font-semibold text-foreground-muted sm:ml-auto">{location}</p>
  </div>
  <div class="flex flex-col gap-1 pb-2 sm:flex-row sm:gap-4">
    <p>{title}</p>
    <p class="font-semibold text-foreground-muted sm:ml-auto">{period}</p>
  </div>
  <ol class="list-disc pl-6 gap-3 flex flex-col">
    {tasks.map((task: string) => <li>{task}</li>)}
  </ol>
</div>
