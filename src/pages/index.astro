---
import AsciiGallery from "../components/AsciiGallery.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout currentPath="/">
  <div class="flex flex-col gap-5">
    <AsciiGallery />
    <div>
      <h1 class="py-2 text-2xl font-semibold">Keez Eden</h1>
      <p>
        Software engineer focused on solving difficult problems quickly. I build products, systems, and tools across
        frontend, backend, infrastructure, and AI.
      </p>
    </div>

    <div>
      <h1 class="py-2 text-2xl font-semibold">When</h1>
      <p>
        I've been programming since 2015 and working professionally since 2018, with a lifelong interest in technology
        and systems.
      </p>
    </div>

    <div>
      <h1 class="py-2 text-2xl font-semibold">Where</h1>
      <p>Based in Napier, New Zealand.</p>
    </div>

    <div>
      <h1 class="py-2 text-2xl font-semibold">Why</h1>
      <p>
        I enjoy difficult, open-ended problems. The best part of software is the ability to rapidly learn, build, and
        iterate across completely different domains.
      </p>
    </div>
  </div>
</MainLayout>
